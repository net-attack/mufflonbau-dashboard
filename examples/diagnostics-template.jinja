{# Paste into Home Assistant Developer Tools > Template. Read-only inventory. #}
{# Intentionally non-recursive: export scalars, flat collections, and one mapping level. #}
{% set domains = ['light', 'group', 'vacuum', 'sensor', 'binary_sensor', 'climate', 'switch', 'humidifier', 'input_button', 'button', 'script', 'camera'] %}
{% set allowed_attributes = ['entity_id', 'device_class', 'unit_of_measurement', 'supported_features', 'supported_color_modes', 'color_mode', 'brightness', 'color_temp_kelvin', 'rgb_color', 'hvac_modes', 'hvac_mode', 'hvac_action', 'temperature', 'current_temperature', 'current_humidity', 'humidity', 'battery_level', 'fan_speed', 'fan_speed_list', 'status', 'error', 'error_code', 'current_room', 'cleaned_area', 'cleaning_time', 'restored', 'assumed_state', 'all'] %}
{% set output = namespace(areas=[], entities=[]) %}
{% for id in areas() | sort %}
  {% set output.areas = output.areas + [{'id': id, 'name': area_name(id)}] %}
{% endfor %}
{% for entity in states | sort(attribute='entity_id') if entity.domain in domains %}
  {% set device = device_id(entity.entity_id) %}
  {% set attrs = namespace(pairs=[]) %}
  {% for key in allowed_attributes if key in entity.attributes %}
    {% set value = entity.attributes[key] %}
    {% set safe = namespace(value='[nested or unsupported value omitted]') %}
    {% if value is none or value is boolean or value is number or value is string %}
      {% set safe.value = value %}
    {% elif value is mapping %}
      {% set fields = namespace(pairs=[]) %}
      {% for field, child in value.items() %}
        {% if child is none or child is boolean or child is number or child is string %}
          {% set fields.pairs = fields.pairs + [(field | string, child)] %}
        {% elif child is iterable and child is not mapping %}
          {% set items = namespace(values=[]) %}
          {% for item in child %}
            {% set items.values = items.values + [item if item is none or item is boolean or item is number or item is string else '[nested value omitted]'] %}
          {% endfor %}
          {% set fields.pairs = fields.pairs + [(field | string, items.values)] %}
        {% else %}
          {% set fields.pairs = fields.pairs + [(field | string, '[nested value omitted]')] %}
        {% endif %}
      {% endfor %}
      {% set safe.value = dict(fields.pairs) %}
    {% elif value is iterable %}
      {% set items = namespace(values=[]) %}
      {% for item in value %}
        {% set items.values = items.values + [item if item is none or item is boolean or item is number or item is string else '[nested value omitted]'] %}
      {% endfor %}
      {% set safe.value = items.values %}
    {% endif %}
    {% set attrs.pairs = attrs.pairs + [(key, safe.value)] %}
  {% endfor %}
  {% set output.entities = output.entities + [{
    'entity_id': entity.entity_id,
    'name': entity.name,
    'state': entity.state,
    'area_id': area_id(entity.entity_id),
    'area_name': area_name(entity.entity_id),
    'device_id': device,
    'device_name': (device_attr(device, 'name_by_user') or device_attr(device, 'name')) if device else none,
    'manufacturer': device_attr(device, 'manufacturer') if device else none,
    'model': device_attr(device, 'model') if device else none,
    'last_updated': entity.last_updated.isoformat(),
    'attributes': dict(attrs.pairs)
  }] %}
{% endfor %}
{{ {'schema_version': 1, 'exported_at': now().isoformat(), 'areas': output.areas, 'entities': output.entities} | to_json(pretty_print=true) }}

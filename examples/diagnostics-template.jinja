{#- Paste into Home Assistant Developer Tools > Template. Read-only inventory. -#}
{#- Intentionally non-recursive: export scalars, flat collections, and one mapping level. -#}
{%- set section = 'lights' -%}
{%- set offset = 0 -%}
{%- set page_size = 40 -%}
{%- set domains = {'lights': ['light', 'group'], 'vacuum': ['vacuum', 'camera', 'input_button', 'button', 'script', 'select'], 'sensors': ['sensor', 'binary_sensor', 'climate', 'humidifier', 'switch']}[section] -%}
{%- set selection = namespace(entities=[], vacuum_devices=[]) -%}
{%- for entity in states if entity.domain == 'vacuum' -%}
  {%- set id = device_id(entity.entity_id) -%}
  {%- if id -%}{%- set selection.vacuum_devices = selection.vacuum_devices + [id] -%}{%- endif -%}
{%- endfor -%}
{%- for entity in states | sort(attribute='entity_id') -%}
  {%- if entity.domain in domains or (section == 'vacuum' and entity.domain in ['sensor', 'binary_sensor'] and device_id(entity.entity_id) in selection.vacuum_devices) -%}
    {%- set selection.entities = selection.entities + [entity] -%}
  {%- endif -%}
{%- endfor -%}
{%- set allowed_attributes = ['entity_id', 'device_class', 'unit_of_measurement', 'supported_features', 'supported_color_modes', 'color_mode', 'brightness', 'color_temp_kelvin', 'rgb_color', 'hvac_modes', 'hvac_mode', 'hvac_action', 'temperature', 'current_temperature', 'current_humidity', 'humidity', 'battery_level', 'fan_speed', 'fan_speed_list', 'status', 'error', 'error_code', 'current_room', 'cleaned_area', 'cleaning_time', 'restored', 'assumed_state', 'all'] -%}
{%- set output = namespace(entities=[], stopped=false) -%}
{%- for entity in selection.entities[offset:offset + page_size] if not output.stopped -%}
  {%- set device = device_id(entity.entity_id) -%}
  {%- set attrs = namespace(pairs=[]) -%}
  {%- for key in allowed_attributes if key in entity.attributes -%}
    {%- set value = entity.attributes[key] -%}
    {%- set safe = namespace(value='[nested or unsupported value omitted]') -%}
    {%- if value is none or value is boolean or value is number or value is string -%}
      {%- set safe.value = value[:500] if value is string else value -%}
    {%- elif value is mapping -%}
      {%- set fields = namespace(pairs=[]) -%}
      {%- for field, child in (value.items() | list)[:30] -%}
        {%- if child is none or child is boolean or child is number or child is string -%}
          {%- set fields.pairs = fields.pairs + [((field | string)[:160], child[:500] if child is string else child)] -%}
        {%- elif child is iterable and child is not mapping -%}
          {%- set items = namespace(values=[]) -%}
          {%- for item in (child | list)[:200] -%}
            {%- set items.values = items.values + [item[:500] if item is string else item if item is none or item is boolean or item is number or item is string else '[nested value omitted]'] -%}
          {%- endfor -%}
          {%- set fields.pairs = fields.pairs + [(field | string, items.values)] -%}
        {%- else -%}
          {%- set fields.pairs = fields.pairs + [(field | string, '[nested value omitted]')] -%}
        {%- endif -%}
      {%- endfor -%}
      {%- set safe.value = dict(fields.pairs) -%}
    {%- elif value is iterable -%}
      {%- set items = namespace(values=[]) -%}
      {%- for item in (value | list)[:200] -%}
        {%- set items.values = items.values + [item[:500] if item is string else item if item is none or item is boolean or item is number or item is string else '[nested value omitted]'] -%}
      {%- endfor -%}
      {%- set safe.value = items.values -%}
    {%- endif -%}
    {%- set attrs.pairs = attrs.pairs + [(key, safe.value)] -%}
  {%- endfor -%}
  {%- set row = {
    'entity_id': entity.entity_id,
    'name': entity.name[:180],
    'state': entity.state[:255],
    'area_id': area_id(entity.entity_id),
    'area_name': (area_name(entity.entity_id) or '')[:180],
    'device_id': device,
    'device_name': ((device_attr(device, 'name_by_user') or device_attr(device, 'name') or '') | string)[:180] if device else none,
    'manufacturer': ((device_attr(device, 'manufacturer') or '') | string)[:180] if device else none,
    'model': ((device_attr(device, 'model') or '') | string)[:180] if device else none,
    'last_updated': entity.last_updated.isoformat(),
    'attributes': dict(attrs.pairs)
  } -%}
  {%- if (row | to_json | length) > 150000 -%}
    {%- set row = dict(row, attributes={'export_note': 'Attributes exceed export budget; inspect this entity separately.'}) -%}
  {%- endif -%}
  {%- set candidate = output.entities + [row] -%}
  {%- if (candidate | to_json | length) < 160000 -%}
    {%- set output.entities = candidate -%}
  {%- else -%}
    {%- set output.stopped = true -%}
  {%- endif -%}
{%- endfor -%}
{{ {'schema_version': 2, 'section': section, 'offset': offset, 'total_matching': selection.entities | length, 'next_offset': offset + (output.entities | length), 'has_more': offset + (output.entities | length) < (selection.entities | length), 'exported_at': now().isoformat(), 'entities': output.entities} | to_json }}

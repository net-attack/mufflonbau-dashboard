{
  "name": "mufflonbau-dashboard",
  "version": "0.4.0-dev.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node --check mufflonbau-dashboard.js",
    "test": "node --test",
    "test:browser": "node scripts/browser-check.mjs",
    "ci": "npm run check && npm test && npm run test:templates && npm run test:browser && npm run test:spatial-production",
    "test:templates": "python3 -m unittest discover -s test -p '*_test.py'",
    "dev:spatial-poc": "node scripts/spatial-poc.mjs",
    "build:spatial-poc": "node scripts/spatial-poc.mjs --build",
    "test:spatial-poc": "node --test test/spatial-poc.test.js && node scripts/spatial-poc-check.mjs",
    "test:spatial-production": "node --test test/spatial-production.test.js && node scripts/spatial-production-check.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "js-yaml": "5.4.2",
    "pixi.js": "8.22.0",
    "playwright": "1.64.1"
  }
}

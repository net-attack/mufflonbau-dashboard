{
  "name": "mufflonbau-dashboard",
  "version": "0.2.0-ventilation.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node --check mufflonbau-dashboard.js",
    "test": "node --test",
    "test:browser": "node scripts/browser-check.mjs",
    "ci": "npm run check && npm test && npm run test:templates && npm run test:browser",
    "test:templates": "python3 -m unittest discover -s test -p '*_test.py'"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "js-yaml": "5.4.2",
    "playwright": "1.64.1"
  }
}
